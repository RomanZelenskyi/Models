<Window x:Class="Mdiapp.Wpf.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Model" Width="732" Height="594" MinWidth="600" MinHeight="400" FontFamily="Segoe UI" FontSize="12" UseLayoutRounding="True" SnapsToDevicePixels="True">
 <Window.Resources>
  <Style x:Key="ClassicToolButton" TargetType="Button">
   <Setter Property="Width" Value="23"/><Setter Property="Height" Value="24"/><Setter Property="Margin" Value="0"/><Setter Property="Padding" Value="3"/><Setter Property="Focusable" Value="False"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                        <Border x:Name="Frame" BorderThickness="1" BorderBrush="Transparent" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="#E5F1FB"/><Setter TargetName="Frame" Property="BorderBrush" Value="#7DA2CE"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Frame" Property="Background" Value="#CCE4F7"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <DockPanel Background="#ABABAB">
  <Menu x:Name="MainMenu" DockPanel.Dock="Top" Background="#FAFAFA" Height="20" Padding="0">
   <MenuItem Header="Файл"><MenuItem Header="Новый проект" Click="NewProject" InputGestureText="Ctrl+N"/><MenuItem Header="Открыть проект INM…" Click="OpenProject" InputGestureText="Ctrl+O"/><MenuItem x:Name="SaveMenu" Header="Сохранить проект" Click="SaveProject" InputGestureText="Ctrl+S"/><MenuItem x:Name="SaveAsMenu" Header="Сохранить проект как…" Click="SaveProjectAs"/><Separator/><MenuItem x:Name="PrintMenu" Header="Печать…" Click="PrintProject"/><MenuItem x:Name="PreviewMenu" Header="Предварительный просмотр печати" Click="PreviewProject"/><Separator/><MenuItem x:Name="CloseMenu" Header="Закрыть вкладку" Click="CloseTab"/><MenuItem Header="Выход" Click="Exit"/></MenuItem>
   <MenuItem Header="Правка"><MenuItem Header="Вырезать" Command="ApplicationCommands.Cut"/><MenuItem Header="Копировать" Command="ApplicationCommands.Copy"/><MenuItem Header="Вставить" Command="ApplicationCommands.Paste"/></MenuItem>
   <MenuItem Header="Вид"><MenuItem Header="Панель инструментов" IsCheckable="True" IsChecked="True" Click="ToggleToolbar"/><MenuItem Header="Строка состояния" IsCheckable="True" IsChecked="True" Click="ToggleStatusbar"/></MenuItem>
   <MenuItem Header="Операции"><MenuItem x:Name="CalculateMenu" Header="Рассчитать" Click="CalculateProject"/><MenuItem x:Name="CancelMenu" Header="Остановить" Click="CancelCalculation"/><Separator/><MenuItem x:Name="ReadMenu" Header="Прочитать результаты…" Click="ImportResults"/><MenuItem x:Name="ExportMenu" Header="Экспорт результатов…" Click="ExportResults"/><Separator/><MenuItem Header="Редакторы"><MenuItem Header="Закон изменения параметра" Click="Series"/><MenuItem Header="Файлы 31–32" Click="Pair3132"/><MenuItem Header="Файл 30" Click="File30"/><MenuItem Header="Отборы 28/281/282" Click="File28"/><MenuItem Header="Файл 24" Click="File24"/><MenuItem Header="Файл 41" Click="File41"/><MenuItem Header="Характеристики с ветвями" Click="Characteristic"/><MenuItem Header="Характеристика X/Y" Click="Curve"/><MenuItem Header="Характеристика X/Y (5, 8, 18, 26)" Click="Curve18"/><MenuItem Header="Две характеристики, файл 14" Click="DoubleCurve"/><MenuItem Header="Три характеристики (21, 22, 27)" Click="TripleCurve"/><MenuItem Header="Таблица X/Y1/Y2" Click="ThreeColumn"/><MenuItem Header="Таблица с тремя исходными значениями" Click="ThreeColumn23"/><MenuItem Header="Четыре характеристики, файл 36" Click="QuadCurve"/><MenuItem Header="Регуляторы (29/40)" Click="Controllers"/><MenuItem Header="Семейства характеристик, файл 1500" Click="MultiCharacteristic"/><MenuItem Header="Коррекция характеристики, файл 1" Click="CorrectedCurve"/><MenuItem Header="Коррекция двух характеристик, файл 14" Click="CorrectedDoubleCurve"/><MenuItem Header="Коррекция характеристики (11, 16, 20)" Click="SimpleCorrection"/><MenuItem Header="Коррекция характеристик с ветвями" Click="CorrectedCharacteristic"/><MenuItem Header="Коррекция турбинных характеристик" Click="TurbineCorrection"/><MenuItem Header="Отборы с коэффициентами (28/281/282)" Click="ExtendedFile28"/><MenuItem Header="Коррекция трёх характеристик (21/22)" Click="CorrectedTripleCurve"/><MenuItem Header="Механические характеристики, файл 300" Click="File300"/><MenuItem Header="Многомерные таблицы (42/45/48)" Click="Surface"/><MenuItem Header="Переходные коэффициенты (43/46/49)" Click="Transition"/><MenuItem Header="Многомерные таблицы ротора (44/47/50)" Click="RotorSurface"/><MenuItem Header="Отборы воздуха и мощности, файл 55" Click="File55"/><MenuItem Header="Параметры ТП, файл 56" Click="File56"/><MenuItem Header="Характеристики по числу Рейнольдса, файл 57" Click="File57"/><MenuItem Header="Файл 51" Click="File51"/></MenuItem>   <Separator/><MenuItem Header="Кодирование COD" Click="Encode"/><MenuItem Header="Декодирование COD" Click="Decode"/></MenuItem>
   <MenuItem Header="Настройки"><MenuItem Header="Создать двигатель" Click="CreateEngine"/><MenuItem Header="Импорт двигателя" Click="ImportEngine"/><Separator/><MenuItem Header="Язык" Click="ChooseLanguage"/><MenuItem x:Name="EngineMenu" Header="Двигатели" Click="Engine"/><MenuItem Header="Настройки сохранения результатов" Click="ExportSettings"/></MenuItem>
   <MenuItem x:Name="WindowsMenu" Header="Окна" SubmenuOpened="PopulateWindows"/>
   <MenuItem Header="Помощь"><MenuItem Header="Руководство пользователя" Click="HelpProgram"/><MenuItem Header="О программе" Click="AboutProgram"/><MenuItem Header="Что нового" Click="UpdateNotice"/></MenuItem>
  </Menu>
  <Border x:Name="MainToolbar" DockPanel.Dock="Top" Background="#F0F0F0" Height="32" BorderBrush="#808080" BorderThickness="0,0,0,1">
   <StackPanel Orientation="Horizontal" Margin="5,2,0,2"><Button x:Name="NewButton" Style="{StaticResource ClassicToolButton}" ToolTip="Новый проект" Click="NewProject"><Canvas Width="16" Height="16"><Path Data="M3,1 L11,1 14,4 14,15 3,15 Z M11,1 L11,4 14,4" Fill="White" Stroke="Black"/></Canvas></Button><Button x:Name="OpenButton" Style="{StaticResource ClassicToolButton}" ToolTip="Открыть проект" Click="OpenProject"><Canvas Width="16" Height="16"><Path Data="M1,4 L6,4 8,6 15,6 15,14 1,14 Z" Fill="#E4C64E" Stroke="Black"/><Path Data="M1,14 L4,8 16,8 13,14 Z" Fill="#FFF293" Stroke="Black"/><Path Data="M9,1 L13,1 13,5 M11,3 L13,5 15,3" Stroke="Black"/></Canvas></Button><Button x:Name="SaveButton" Style="{StaticResource ClassicToolButton}" ToolTip="Сохранить проект" Click="SaveProject"><Canvas Width="16" Height="16"><Path Data="M1,1 L13,1 15,3 15,15 1,15 Z" Fill="#C3B75D" Stroke="Black"/><Path Data="M4,1 L11,1 11,6 4,6 Z" Fill="#EEEEEE" Stroke="Black"/><Path Data="M4,9 L12,9 12,15 4,15 Z" Fill="#EEEEEE" Stroke="Black"/><Path Data="M9,2 L9,5" Stroke="Black"/></Canvas></Button><Border Width="8"><Border Width="1" Height="20" Background="#D0D0D0" HorizontalAlignment="Center"/></Border><Button x:Name="CutButton" Style="{StaticResource ClassicToolButton}" ToolTip="Вырезать" Command="ApplicationCommands.Cut"><Canvas Width="16" Height="16"><Path Data="M5,10 L11,1 M10,10 L5,1" Stroke="#444444"/><Ellipse Canvas.Left="2" Canvas.Top="10" Width="5" Height="5" Stroke="#444444"/><Ellipse Canvas.Left="9" Canvas.Top="10" Width="5" Height="5" Stroke="#444444"/></Canvas></Button><Button x:Name="CopyButton" Style="{StaticResource ClassicToolButton}" ToolTip="Копировать" Command="ApplicationCommands.Copy"><Canvas Width="16" Height="16"><Path Data="M1,1 L9,1 9,11 1,11 Z M6,5 L14,5 14,15 6,15 Z" Fill="#FAFAFA" Stroke="#444444"/><Path Data="M8,8 L12,8 M8,10 L12,10 M8,12 L12,12" Stroke="#777777"/></Canvas></Button><Button x:Name="PasteButton" Style="{StaticResource ClassicToolButton}" ToolTip="Вставить" Command="ApplicationCommands.Paste"><Canvas Width="16" Height="16"><Path Data="M3,3 L13,3 13,15 3,15 Z" Fill="#B8AA7A" Stroke="#444444"/><Path Data="M6,1 L10,1 10,5 6,5 Z M7,7 L15,7 15,15 7,15 Z" Fill="#FAFAFA" Stroke="#444444"/><Path Data="M9,10 L13,10 M9,12 L13,12" Stroke="#777777"/></Canvas></Button><Border Width="8"><Border Width="1" Height="20" Background="#D0D0D0" HorizontalAlignment="Center"/></Border><Button x:Name="CascadeButton" Style="{StaticResource ClassicToolButton}" ToolTip="Каскад окон" IsEnabled="False"><Canvas Width="16" Height="16"><Path Data="M1,1 L11,1 11,10 1,10 Z M3,3 L13,3 13,12 3,12 Z M5,5 L15,5 15,15 5,15 Z M5,8 L15,8" Fill="#EEEEEE" Stroke="#444444"/></Canvas></Button><Button x:Name="HorizontalButton" Style="{StaticResource ClassicToolButton}" ToolTip="Окна по горизонтали" IsEnabled="False"><Canvas Width="16" Height="16"><Path Data="M2,1 L14,1 14,7 2,7 Z M2,9 L14,9 14,15 2,15 Z M2,3 L14,3 M2,11 L14,11" Fill="#EEEEEE" Stroke="#444444"/></Canvas></Button><Button x:Name="VerticalButton" Style="{StaticResource ClassicToolButton}" ToolTip="Окна по вертикали" IsEnabled="False"><Canvas Width="16" Height="16"><Path Data="M1,2 L7,2 7,15 1,15 Z M9,2 L15,2 15,15 9,15 Z M1,4 L7,4 M9,4 L15,4" Fill="#EEEEEE" Stroke="#444444"/></Canvas></Button><Border Width="8"><Border Width="1" Height="20" Background="#D0D0D0" HorizontalAlignment="Center"/></Border><Button x:Name="CalculateButton" Style="{StaticResource ClassicToolButton}" ToolTip="Рассчитать" Click="CalculateProject"><Canvas Width="16" Height="16"><Rectangle Width="16" Height="16" Fill="#142832"/><Ellipse Canvas.Left="2" Canvas.Top="2" Width="12" Height="12" Fill="#E7CE44" Stroke="#EAEAEA"/><Path Data="M8,1 L8,15 M1,8 L15,8 M3,3 L13,13 M3,13 L13,3" Stroke="#297B7B"/><Ellipse Canvas.Left="5" Canvas.Top="5" Width="6" Height="6" Fill="#D6B439" Stroke="White"/></Canvas></Button>   </StackPanel>
  </Border>
  <StatusBar x:Name="MainStatusbar" DockPanel.Dock="Bottom" Height="20" Padding="0" Background="#F0F0F0" BorderThickness="0,1,0,0" BorderBrush="White"><TextBlock x:Name="Status" Margin="4,0"/></StatusBar>
  <Border BorderThickness="1" BorderBrush="#808080" Background="#ABABAB">
   <TabControl x:Name="Documents" Margin="0" Background="#ABABAB" BorderThickness="0" SelectionChanged="DocumentChanged"><TabControl.Style><Style TargetType="TabControl"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><Trigger Property="HasItems" Value="False"><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></TabControl.Style></TabControl>
  </Border>
 </DockPanel>
</Window>



